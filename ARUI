local spectateConn = nil
local function stopSpectate()
    if spectateConn then spectateConn:Disconnect(); spectateConn = nil end
    if player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then Camera.CameraSubject = hum end
    end
end

WepRight:Dropdown({ Name = "Spectate Player", Content = playerOpts, Default = "Select...", Flag = "SpectatePlayer",
    Callback = function(v)
        stopSpectate()
        if not v or v == "Select..." then return end
        local t = Players:FindFirstChild(v)
        if not t or not t.Character then return end
        local hum = t.Character:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        Camera.CameraSubject = hum
        spectateConn = RunService.RenderStepped:Connect(function()
            if t and t.Character then
                local h2 = t.Character:FindFirstChildOfClass("Humanoid")
                if h2 and h2.Health > 0 then Camera.CameraSubject = h2 end
            end
        end)
